# Token bota Telegram uzyskany od @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_twoj_token_tutaj

# ID czatu, na który bot ma wysyłać powiadomienia (patrz README.md)
TELEGRAM_CHAT_ID=123456789

# Jak często (w sekundach) sprawdzać ogłoszenia — domyślnie 200
CHECK_INTERVAL=200

# Lista linków wyszukiwania OLX, oddzielonych przecinkami (bez spacji na początku/końcu)
SEARCH_URLS=https://www.olx.pl/przyklad-wyszukiwania-1/,https://www.olx.pl/przyklad-wyszukiwania-2/,https://www.olx.pl/przyklad-wyszukiwania-3/,https://www.olx.pl/przyklad-wyszukiwania-4/
